# Production target
BASE_APP_URL=https://clinic.peoplesdoctor.ai

# Dedicated smoke-monitor account
TEST_USERNAME=
TEST_PASSWORD=

# Deep regression and FNX monitor account
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Exact authentication cookie used by the audio API
AUTH_COOKIE_NAME=pc-accessToken

# Test fixtures and expectation manifests
AUDIO_FILE_PATH=test_data/consultation-audio.webm
AUDIO_ORACLE_PATH=test_data/consultation-audio.oracle.json
FNX_FILE_PATH=test_data/2024-12-14_CGM_P300_1_Ref.FNX
FNX_ORACLE_PATH=test_data/fnx.oracle.json

# Optional local alert testing. GitHub Actions reads these from repository secrets.
MAIL_SERVER_ADDRESS=
MAIL_SERVER_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_ADDRESS=
MAIL_RECIPIENT_ADDRESS=
ALERT_START_HOUR_UTC=4
ALERT_END_HOUR_UTC=17
